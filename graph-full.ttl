# graph-full.ttl — merged eco.ttl + harvested + scenario, generated by run.py.
# 360 triples. Do NOT edit; regenerate with `python3 harvest.py && python3 run.py`.
# Published at https://la3d-llm-agents.github.io/graph/graph-full.ttl

@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix eco: <https://la3d-llm-agents.github.io/ns/eco#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://la3d-llm-agents.github.io/ns/eco> a owl:Ontology ;
    rdfs:label "Ecosystem structural upper ontology (eco)" ;
    rdfs:comment "A thin structural upper ontology composing PROV-O, DCAT and SKOS. Shape, not meaning." .

eco:Commercial a eco:Visibility ;
    rdfs:label "commercial" ;
    skos:inScheme eco:VisibilityScheme ;
    skos:prefLabel "commercial" ;
    eco:rank 3 .

eco:InDevelopment a eco:Maturity ;
    rdfs:label "in-development" ;
    skos:inScheme eco:MaturityScheme ;
    skos:prefLabel "in-development" .

eco:Private a eco:Visibility ;
    rdfs:label "private" ;
    skos:inScheme eco:VisibilityScheme ;
    skos:prefLabel "private" ;
    eco:rank 2 .

eco:answer-3 a eco:Answer ;
    rdfs:label "Which drugs did the PAD network identify on this card?" ;
    prov:wasAttributedTo eco:agent-pad,
        eco:person-chris ;
    prov:wasDerivedFrom eco:cap-pad-neural-networks ;
    eco:filedInto <did:web:la3d-llm-agents.github.io:id:rare-disease-wiki> .

eco:answer-4 a eco:Answer ;
    rdfs:label "NPC research-volume vs trial-activity synthesis" ;
    prov:wasAttributedTo eco:agent-askdb,
        eco:person-chris ;
    prov:wasDerivedFrom eco:answer-1,
        eco:answer-2 ;
    eco:filedInto <did:web:la3d-llm-agents.github.io:id:rare-disease-wiki> .

eco:atCommit a owl:DatatypeProperty ;
    rdfs:label "at commit" ;
    rdfs:comment "Commit pin: prov:wasDerivedFrom <bundle>@<commit> as a literal." ;
    rdfs:domain eco:Answer ;
    rdfs:range xsd:string .

eco:consumptionMode a owl:ObjectProperty ;
    rdfs:label "consumption mode" ;
    rdfs:domain eco:Participant ;
    rdfs:range eco:ConsumptionMode .

eco:filedInto a owl:ObjectProperty ;
    rdfs:label "filed into" ;
    rdfs:comment "The bundle an answer is written into (Stage 6)." ;
    rdfs:domain eco:Answer ;
    rdfs:range eco:Bundle .

eco:hasCapability a owl:ObjectProperty ;
    rdfs:label "has capability" ;
    rdfs:domain eco:Connector ;
    rdfs:range eco:Capability ;
    owl:inverseOf eco:providedBy .

eco:hasMaturity a owl:ObjectProperty ;
    rdfs:label "has maturity" ;
    rdfs:comment "Only eco:Production is authoritative; authority propagates along provenance." ;
    rdfs:range eco:Maturity .

eco:hasOntology a owl:ObjectProperty ;
    rdfs:label "has ontology" ;
    rdfs:domain eco:Participant ;
    rdfs:range eco:Ontology .

eco:hasService a owl:ObjectProperty ;
    rdfs:label "has service" ;
    rdfs:comment "Kin to dcat:service and to a DID-document service entry." ;
    rdfs:domain eco:Participant ;
    rdfs:range eco:ServiceEndpoint .

eco:hasVisibility a owl:ObjectProperty ;
    rdfs:label "has visibility" ;
    rdfs:comment "Kin to dct:accessRights / an ODRL policy constraint." ;
    rdfs:range eco:Visibility .

eco:keyword a owl:DatatypeProperty ;
    rdfs:label "keyword" ;
    rdfs:domain eco:Capability ;
    rdfs:range xsd:string .

eco:memberOf a owl:ObjectProperty ;
    rdfs:label "member of" ;
    rdfs:domain eco:Participant ;
    rdfs:range eco:Federation .

eco:rank a owl:DatatypeProperty ;
    rdfs:label "openness rank" ;
    rdfs:comment "Lower = more open; a target more open than a source permits is a leak." ;
    rdfs:domain eco:Visibility ;
    rdfs:range xsd:integer .

eco:reachableVia a owl:ObjectProperty ;
    rdfs:label "reachable via" ;
    rdfs:domain eco:Connector ;
    rdfs:range eco:Broker .

eco:CloneAndInvoke a eco:ConsumptionMode ;
    rdfs:label "clone-and-invoke" ;
    skos:inScheme eco:ConsumptionScheme ;
    skos:prefLabel "clone-and-invoke" .

eco:CloneEndpoint a owl:Class ;
    rdfs:label "Clone endpoint" ;
    rdfs:comment "git clone target — how an ask reaches a bundle (no live infra)." ;
    rdfs:subClassOf eco:ServiceEndpoint .

eco:DerivedOntology a owl:Class ;
    rdfs:label "Derived ontology" ;
    rdfs:comment "Structural skeleton derived from a schema (db_ontology); semantics human-authored." ;
    rdfs:subClassOf eco:Ontology .

eco:Institutional a eco:Visibility ;
    rdfs:label "institutional" ;
    skos:inScheme eco:VisibilityScheme ;
    skos:prefLabel "institutional" ;
    eco:rank 1 .

eco:OAuthBroker a eco:Broker ;
    rdfs:label "OAuth broker" .

eco:OpenAPI a owl:Class ;
    rdfs:label "OpenAPI contract" ;
    rdfs:subClassOf eco:ServiceEndpoint .

eco:PublishedOntology a owl:Class ;
    rdfs:label "Published ontology" ;
    rdfs:comment "Published by the source itself (e.g. PAD's pad: OWL)." ;
    rdfs:subClassOf eco:Ontology .

eco:ReadOnlyDBBroker a eco:Broker ;
    rdfs:label "read-only DB broker" .

eco:agent-pad a prov:SoftwareAgent ;
    rdfs:label "pad-connector (agent label; DID deferred)" ;
    prov:actedOnBehalfOf eco:person-chris .

eco:answer-1 a eco:Answer ;
    rdfs:label "How many analysis-ready publications does NPC have?" ;
    prov:wasAttributedTo eco:agent-askdb,
        eco:person-chris ;
    prov:wasDerivedFrom eco:cap-db-analysis-corpus-for-disease ;
    eco:atCommit "rare-disease-copy@c3be904" ;
    eco:filedInto <did:web:la3d-llm-agents.github.io:id:rare-disease-wiki> .

eco:answer-2 a eco:Answer ;
    rdfs:label "How many clinical trials does NPC have?" ;
    prov:wasAttributedTo eco:agent-askdb,
        eco:person-chris ;
    prov:wasDerivedFrom eco:cap-db-clinical-trials-per-disease ;
    eco:atCommit "rare-disease-copy@c3be904" ;
    eco:filedInto <did:web:la3d-llm-agents.github.io:id:rare-disease-wiki> .

eco:cap-db-all-publications-for-disease a eco:Capability ;
    rdfs:label "Every publication linked to the disease, with no analysis filtering." ;
    eco:hasMaturity eco:Production ;
    eco:keyword "all",
        "disease",
        "publications" ;
    eco:providedBy <did:web:la3d-llm-agents.github.io:id:rare-disease-db> .

eco:cap-db-corpus-status-breakdown a eco:Capability ;
    rdfs:label "Counts of total, analysis-ready, needs_review, and corpus_excluded publications," ;
    eco:hasMaturity eco:Production ;
    eco:keyword "breakdown",
        "corpus",
        "disease",
        "status" ;
    eco:providedBy <did:web:la3d-llm-agents.github.io:id:rare-disease-db> .

eco:cap-db-diseases-with-analysis-corpus a eco:Capability ;
    rdfs:label "Diseases with at least one analysis-ready publication, annotated with publicatio" ;
    eco:hasMaturity eco:Production ;
    eco:keyword "analysis",
        "corpus",
        "disease",
        "diseases" ;
    eco:providedBy <did:web:la3d-llm-agents.github.io:id:rare-disease-db> .

eco:cap-db-publications-vs-trials-by-disease a eco:Capability ;
    rdfs:label "Publication count and clinical-trial count side by side per disease, most public" ;
    eco:hasMaturity eco:Beta ;
    eco:keyword "clinical",
        "disease",
        "publications",
        "trials" ;
    eco:providedBy <did:web:la3d-llm-agents.github.io:id:rare-disease-db> .

eco:cap-pad-cards a eco:Capability ;
    rdfs:label "PAD: Cards" ;
    eco:hasMaturity eco:Beta ;
    eco:keyword "cards" ;
    eco:providedBy <did:web:pad.crc.nd.edu> .

eco:cap-pad-layout a eco:Capability ;
    rdfs:label "PAD: Layout" ;
    eco:hasMaturity eco:Beta ;
    eco:keyword "layout" ;
    eco:providedBy <did:web:pad.crc.nd.edu> .

eco:cap-pad-projects a eco:Capability ;
    rdfs:label "PAD: Projects" ;
    eco:hasMaturity eco:Beta ;
    eco:keyword "projects" ;
    eco:providedBy <did:web:pad.crc.nd.edu> .

eco:cap-pad-reagents a eco:Capability ;
    rdfs:label "PAD: Reagents" ;
    eco:hasMaturity eco:Beta ;
    eco:keyword "reagents" ;
    eco:providedBy <did:web:pad.crc.nd.edu> .

eco:cap-pad-samples a eco:Capability ;
    rdfs:label "PAD: Samples" ;
    eco:hasMaturity eco:Beta ;
    eco:keyword "samples" ;
    eco:providedBy <did:web:pad.crc.nd.edu> .

eco:pad-ontology a eco:PublishedOntology ;
    rdfs:label "pad: OWL ontology (published by the service)" ;
    dcat:downloadURL <https://pad.crc.nd.edu/ontology/ontology.ttl> .

eco:providedBy a owl:ObjectProperty ;
    rdfs:label "provided by" ;
    rdfs:domain eco:Capability ;
    rdfs:range eco:Participant .

eco:rd-ontology a eco:DerivedOntology ;
    rdfs:label "rare-disease structural ontology (derived by db_ontology)" .

eco:svc-did-web-la3d-llm-agents-github-io-id-rare-disease-db-agentcard a eco:AgentCard,
        eco:ServiceEndpoint ;
    rdfs:label "AgentCard" ;
    dcat:accessURL <https://la3d-llm-agents.github.io/id/rare-disease-db/.well-known/agent-card.json> .

eco:svc-did-web-la3d-llm-agents-github-io-id-rare-disease-wiki-agentcard a eco:AgentCard,
        eco:ServiceEndpoint ;
    rdfs:label "AgentCard" ;
    dcat:accessURL <https://la3d-llm-agents.github.io/id/rare-disease-wiki/.well-known/agent-card.json> .

eco:svc-did-web-la3d-llm-agents-github-io-id-rare-disease-wiki-cloneendpoint a eco:CloneEndpoint,
        eco:ServiceEndpoint ;
    rdfs:label "CloneEndpoint" ;
    dcat:accessURL <https://github.com/crcresearch/rare-disease-copy.wiki.git> .

eco:svc-did-web-pad-crc-nd-edu-agentcard a eco:AgentCard,
        eco:ServiceEndpoint ;
    rdfs:label "AgentCard" ;
    dcat:accessURL <https://pad.crc.nd.edu/.well-known/agent-card.json> .

eco:svc-did-web-pad-crc-nd-edu-openapi a eco:OpenAPI,
        eco:ServiceEndpoint ;
    rdfs:label "OpenAPI" ;
    dcat:accessURL <https://pad.crc.nd.edu/openapi.json> .

eco:svc-did-web-pad-crc-nd-edu-publishedontology a eco:ServiceEndpoint ;
    rdfs:label "PublishedOntology" ;
    dcat:accessURL <https://pad.crc.nd.edu/ontology/ontology.ttl> .

eco:BrokeredConnector a eco:ConsumptionMode ;
    rdfs:label "brokered-connector" ;
    skos:inScheme eco:ConsumptionScheme ;
    skos:prefLabel "brokered-connector" .

eco:Bundle a owl:Class ;
    rdfs:label "Bundle" ;
    rdfs:comment "Published knowledge (a wiki); discovered, cloned, cited. The ask target." ;
    rdfs:subClassOf dcat:Dataset,
        eco:Participant .

eco:ConsumptionScheme a skos:ConceptScheme ;
    rdfs:label "Consumption modes" .

eco:Federation a owl:Class ;
    rdfs:label "Federation" ;
    rdfs:comment "A seed catalog peers harvest from." ;
    rdfs:subClassOf dcat:Catalog,
        eco:Participant .

eco:cap-db-analysis-corpus-for-disease a eco:Capability ;
    rdfs:label "Publications linked to the disease, filtered to the analysis corpus (excludes ne" ;
    eco:hasMaturity eco:Production ;
    eco:keyword "analysis",
        "corpus",
        "disease" ;
    eco:providedBy <did:web:la3d-llm-agents.github.io:id:rare-disease-db> .

eco:cap-db-clinical-trials-per-disease a eco:Capability ;
    rdfs:label "Clinical-trial count per disease, most trials first. Aggregates over the Clinica" ;
    eco:hasMaturity eco:Beta ;
    eco:keyword "clinical",
        "disease",
        "trials" ;
    eco:providedBy <did:web:la3d-llm-agents.github.io:id:rare-disease-db> .

eco:cap-pad-neural-networks a eco:Capability ;
    rdfs:label "PAD: Neural Networks" ;
    eco:hasMaturity eco:Beta ;
    eco:keyword "drug",
        "identification",
        "networks",
        "neural",
        "quality" ;
    eco:providedBy <did:web:pad.crc.nd.edu> .

<did:web:la3d-llm-agents.github.io> a dcat:Catalog,
        eco:Federation ;
    rdfs:label "LA3D-LLM-Agents federation (seed catalog)" ;
    eco:hasVisibility eco:Public .

eco:AgentCard a owl:Class ;
    rdfs:label "A2A agent-card" ;
    rdfs:comment "Capability advertisement at .well-known/agent-card.json." ;
    rdfs:subClassOf eco:ServiceEndpoint .

eco:Broker a owl:Class ;
    rdfs:label "Broker" ;
    rdfs:comment "Control-plane component that holds a secret and fetches (Agent-Source-Auth)." .

eco:ConsumptionMode a owl:Class ;
    rdfs:label "Consumption mode" ;
    rdfs:subClassOf skos:Concept .

eco:MaturityScheme a skos:ConceptScheme ;
    rdfs:label "Component maturity" ;
    rdfs:comment "Only eco:Production is authoritative (Component-Maturity)." .

eco:Ontology a owl:Class ;
    rdfs:label "Source ontology" ;
    rdfs:comment "A source's small ontology — the reason-over-it-without-guessing layer." .

eco:Public a eco:Visibility ;
    rdfs:label "public" ;
    skos:inScheme eco:VisibilityScheme ;
    skos:prefLabel "public" ;
    eco:rank 0 .

eco:agent-askdb a prov:SoftwareAgent ;
    rdfs:label "ask-db (agent label; DID deferred)" ;
    prov:actedOnBehalfOf eco:person-chris .

<did:web:la3d-llm-agents.github.io:id:rare-disease-wiki> a dcat:Catalog,
        eco:Bundle ;
    rdfs:label "Rare-disease wiki bundle" ;
    eco:consumptionMode eco:CloneAndInvoke ;
    eco:hasService eco:svc-did-web-la3d-llm-agents-github-io-id-rare-disease-wiki-agentcard,
        eco:svc-did-web-la3d-llm-agents-github-io-id-rare-disease-wiki-cloneendpoint ;
    eco:hasVisibility eco:Public ;
    eco:memberOf <did:web:la3d-llm-agents.github.io> .

eco:Connector a owl:Class ;
    rdfs:label "Connector" ;
    rdfs:comment "An agent wrapping an external source read-only (API or DB), declaring capabilities." ;
    rdfs:subClassOf dcat:DataService,
        eco:Participant .

eco:Maturity a owl:Class ;
    rdfs:label "Maturity" ;
    rdfs:subClassOf skos:Concept .

eco:Production a eco:Maturity ;
    rdfs:label "production" ;
    skos:inScheme eco:MaturityScheme ;
    skos:prefLabel "production" .

eco:VisibilityScheme a skos:ConceptScheme ;
    rdfs:label "Visibility ladder (public < institutional < private < commercial)" .

<did:web:la3d-llm-agents.github.io:id:rare-disease-db> a dcat:DataService,
        eco:Connector ;
    rdfs:label "Rare-disease publications DB connector (/ask-db)" ;
    eco:consumptionMode eco:BrokeredConnector ;
    eco:hasCapability eco:cap-db-all-publications-for-disease,
        eco:cap-db-analysis-corpus-for-disease,
        eco:cap-db-clinical-trials-per-disease,
        eco:cap-db-corpus-status-breakdown,
        eco:cap-db-diseases-with-analysis-corpus,
        eco:cap-db-publications-vs-trials-by-disease ;
    eco:hasOntology eco:rd-ontology ;
    eco:hasService eco:svc-did-web-la3d-llm-agents-github-io-id-rare-disease-db-agentcard ;
    eco:hasVisibility eco:Public ;
    eco:memberOf <did:web:la3d-llm-agents.github.io> ;
    eco:reachableVia eco:ReadOnlyDBBroker .

<did:web:pad.crc.nd.edu> a dcat:DataService,
        eco:Connector ;
    rdfs:label "Paper Analytical Devices connector" ;
    eco:consumptionMode eco:BrokeredConnector ;
    eco:hasCapability eco:cap-pad-cards,
        eco:cap-pad-layout,
        eco:cap-pad-neural-networks,
        eco:cap-pad-projects,
        eco:cap-pad-reagents,
        eco:cap-pad-samples ;
    eco:hasMaturity eco:Beta ;
    eco:hasOntology eco:pad-ontology ;
    eco:hasService eco:svc-did-web-pad-crc-nd-edu-agentcard,
        eco:svc-did-web-pad-crc-nd-edu-openapi,
        eco:svc-did-web-pad-crc-nd-edu-publishedontology ;
    eco:hasVisibility eco:Institutional ;
    eco:memberOf <did:web:la3d-llm-agents.github.io> ;
    eco:reachableVia eco:OAuthBroker .

eco:Answer a owl:Class ;
    rdfs:label "Answer" ;
    rdfs:comment "A produced result carrying a provenance chain, attribution, a commit pin, and a file-back target." ;
    rdfs:subClassOf prov:Entity .

eco:Visibility a owl:Class ;
    rdfs:label "Visibility" ;
    rdfs:subClassOf skos:Concept .

eco:person-chris a prov:Person ;
    rdfs:label "Chris Sweet (git author identity)" .

eco:Participant a owl:Class ;
    rdfs:label "Participant" ;
    rdfs:comment "Anything with a DID that plays in the fabric: a connector, a bundle, or the federation." .

eco:Beta a eco:Maturity ;
    rdfs:label "beta" ;
    skos:inScheme eco:MaturityScheme ;
    skos:prefLabel "beta" .

eco:ServiceEndpoint a owl:Class ;
    rdfs:label "Service endpoint" ;
    rdfs:comment "A resolvable endpoint listed on a participant's DID document." .

eco:Capability a owl:Class ;
    rdfs:label "Capability" ;
    rdfs:comment "A discoverable ability (advertised via an A2A card's skills), delivery-mode-agnostic." .

